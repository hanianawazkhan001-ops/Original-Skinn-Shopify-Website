<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- liquid
  assign brand = settings.brand_name | default: 'Original Skinn'
  if template.name == 'index'
    assign tab_title = 'Home'
  elsif template.name == 'cart'
    assign tab_title = 'Basket'
  else
    assign tab_title = page_title
  endif
  # product SEO titles from the store already end in "| Original Skinn"
  assign full_title = tab_title | append: ' | ' | append: brand
  if tab_title contains brand
    assign full_title = tab_title
  endif
-%}
<title>{{ full_title }}</title>
<meta name="description" content="{{ page_description | default: settings.meta_description | escape }}">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
{{ 'original-skinn.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
{% sections 'header-group' %}
<section class="page-section entering" data-page="{% render 'page-key' %}">
{% section 'announcement-bar' %}
{%- capture main_class -%}{% render 'main-class' %}{%- endcapture -%}
<main id="MainContent"{% if main_class != blank %} class="{{ main_class }}"{% endif %}>
{{ content_for_layout }}
</main>
</section>
{% sections 'footer-group' %}
<div class="toast" id="toast" role="status" aria-live="polite">Added to bag</div>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>

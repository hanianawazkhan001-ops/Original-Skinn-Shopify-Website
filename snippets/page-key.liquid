{%- comment -%}
  Prints the page name the design's CSS uses (the same names as the test site),
  e.g. home, shop-all, face, body, bath-shower, baby, home-fragrance, product, basket, about.
  Collection and page names from Alex's store that differ are mapped here.
{%- endcomment -%}
{%- liquid
  case template.name
    when 'index'
      assign key = 'home'
    when 'product'
      assign key = 'product'
    when 'cart'
      assign key = 'basket'
    when 'search'
      assign key = 'shop-all'
    when 'collection'
      assign key = collection.handle
      case collection.handle
        when 'all', 'shop-all', 'all-products'
          assign key = 'shop-all'
        when 'face-cleansers', 'face-moisturisers', 'face-sets'
          assign key = 'face'
        when 'body-and-hair', 'body-care', 'body-butters', 'skin-nourishing-balms'
          assign key = 'body'
        when 'bath-and-shower', 'bath-shower', 'salt-scrubs', 'bath-soaks', 'bath-sets', 'shower-steamers'
          assign key = 'bath-shower'
        when 'baby-shop', 'baby-care'
          assign key = 'baby'
        when 'home-fragrances', 'candles', 'reed-diffusers', 'room-sprays', 'car-blends'
          assign key = 'home-fragrance'
      endcase
    when 'page'
      assign key = page.handle
      case page.handle
        when 'about-us'
          assign key = 'about'
        when 'faq'
          assign key = 'faqs'
        when 'contact-us'
          assign key = 'contact'
        when 'delivery', 'shipping', 'delivery-and-returns', 'shipping-returns'
          assign key = 'delivery-returns'
      endcase
    else
      assign key = template.name
  endcase
-%}
{{- key -}}

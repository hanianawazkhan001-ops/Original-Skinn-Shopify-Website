{%- comment -%} Makes the reviews app (Judge.me) match the site: fonts, forest-green stars and pill buttons. {%- endcomment -%}
{%- style -%}
.os-reviews .jdgm-widget,.os-app-reviews .jdgm-widget,.os-rating,.os-reviews .jm-text,.os-app-reviews .jm-text{font-family:var(--sans)!important;color:var(--forest)!important}
.os-reviews .jdgm-rev-widg__title,.os-reviews .jm-review-widget-minimal-header__title,.os-reviews .jdgm-empty-state{display:none!important}
.jdgm-star,.jm-star{color:var(--forest)!important}
.os-rating{margin:-4px 0 12px;font-size:12px}
.os-reviews .jdgm-rev-widg,.os-app-reviews .jdgm-widget{border-color:var(--line)!important}
.os-reviews .jdgm-rev__title,.os-app-reviews .jdgm-carousel-item__review-title{font-family:Georgia,"Times New Roman",serif;font-weight:400}
.os-reviews .jdgm-write-rev-link,.os-reviews .jdgm-btn,.os-app-reviews .jdgm-btn,.os-reviews .jm-button--primary,.os-app-reviews .jm-button--primary{background:var(--forest)!important;border-color:var(--forest)!important;color:#fff!important;border-radius:999px!important;min-height:44px;padding:0 22px!important;font-family:var(--sans)!important;font-size:9.5px!important;font-weight:700!important;letter-spacing:.12em;text-transform:uppercase}
.os-reviews .jm-button--primary:hover,.os-app-reviews .jm-button--primary:hover{background:var(--forest2)!important}
/* Judge.me Cards Carousel (Google reviews synced into Judge.me): our cards, no duplicate heading */
.os-app-reviews .jdgm-cards-carousel{--text-color:var(--ink)!important;--card-color:var(--paper)!important;--header-color:var(--ink)!important;--arrows-color:var(--forest)!important;--border-radius:20px!important;--max-width:100%!important;max-width:100%!important}
.os-app-reviews .jdgm-cards-carousel .jdgm-title,.os-app-reviews .jdgm-cards-carousel .jdgm-product-name{display:none!important}
.os-app-reviews .jdgm-cards-carousel .jdgm-header{text-align:left;margin:0 0 6px}
.os-app-reviews .jdgm-cards-carousel .jdgm-header-info,.os-app-reviews .jdgm-cards-carousel .jdgm-average-rating{justify-content:flex-start}
.os-app-reviews .jdgm-cards-carousel .jdgm-rating-text{font-size:13px}
.os-app-reviews .jdgm-cards-carousel .jdgm-card{border:1px solid var(--line);text-align:left}
.os-app-reviews .jdgm-cards-carousel .jdgm-text,.os-app-reviews .jdgm-cards-carousel .jdgm-text p{font-family:var(--serif)!important;font-size:17px;line-height:1.45;color:var(--ink)!important;text-align:left}
.os-app-reviews .jdgm-cards-carousel .jdgm-rating-section{align-items:flex-start;text-align:left}
.os-app-reviews .jdgm-cards-carousel .jdgm-reviewer-name{font-size:12px;font-weight:600;color:var(--ink)!important}
.reviews .os-app-reviews .jdgm-widget{color:#fff!important}
.reviews .os-app-reviews .jdgm-cards-carousel{--arrows-color:#fff!important}
.reviews .os-app-reviews .jdgm-header .jdgm-star,.reviews .os-app-reviews .jdgm-rating-star{color:#d9c3a2!important}
.reviews .os-app-reviews .jdgm-rating-text{color:#d5dfd6!important}
.rv-app .jdgm-cards-carousel .jdgm-header{display:none!important}
/* Judge.me Reviews Grid on the Reviews page: cream cards, readable text, no duplicate header (our summary sits above) */
.rv-app .jdgm-reviews-grid-widget[data-widget-container]{--jm-reviews-grid-widget-overlay-and-background-color:var(--paper)!important;--jm-reviews-grid-widget-content-color:var(--ink)!important;--jm-reviews-grid-widget-star-and-reviewer-name-color:var(--forest)!important;--jm-reviews-grid-widget-header-text-color:var(--ink)!important;--jm-reviews-grid-widget-text-color:var(--forest)!important;--jm-reviews-grid-widget-drop-shadow-color:transparent!important}
.rv-app .jdgm-reviews-grid-widget .jm-grid-header{display:none!important}
.rv-app .jdgm-reviews-grid-widget .jm-text{color:var(--ink)!important}
.rv-app .jdgm-review-card{border:1px solid var(--line);border-radius:20px!important;overflow:hidden;background:var(--paper)!important}
.rv-app .jdgm-review-card__details-description,.rv-app .jdgm-review-card__preview .jm-text:not(.jdgm-review-card__reviewer-name){font-family:var(--serif)!important;font-size:16px!important;line-height:1.5!important;text-align:left!important}
.rv-app .jdgm-review-card__reviewer-name{font-family:var(--sans)!important;font-size:13px!important;color:var(--forest)!important}
.rv-app .jm-star-rating__filled{color:var(--forest)!important}
{%- endstyle -%}

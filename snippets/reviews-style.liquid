{%- comment -%} Makes the reviews app (Judge.me) match the site: fonts, forest-green stars and pill buttons. {%- endcomment -%}
{%- style -%}
.os-reviews .jdgm-widget,.os-app-reviews .jdgm-widget,.os-rating{font-family:inherit;color:var(--forest)}
.os-reviews .jdgm-rev-widg__title{display:none}
.jdgm-star{color:var(--forest)!important}
.os-rating{margin:-4px 0 12px;font-size:12px}
.os-reviews .jdgm-rev-widg,.os-app-reviews .jdgm-widget{border-color:var(--line)!important}
.os-reviews .jdgm-rev__title,.os-app-reviews .jdgm-carousel-item__review-title{font-family:Georgia,"Times New Roman",serif;font-weight:400}
.os-reviews .jdgm-write-rev-link,.os-reviews .jdgm-btn,.os-app-reviews .jdgm-btn{background:var(--forest)!important;border-color:var(--forest)!important;color:#fff!important;border-radius:999px!important;font-size:9.5px!important;font-weight:700!important;letter-spacing:.12em;text-transform:uppercase}
{%- endstyle -%}

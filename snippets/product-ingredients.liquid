{%- comment -%}
  The Ingredients tab, laid out as on the test site.
  Params: text (the product's ingredients field; one line per product in a set, "Name: list"), note
{%- endcomment -%}
{%- assign note_html = '<p class="accordion-note">' | append: note | append: '</p>' -%}
{%- if text == blank -%}
<p>The full ingredient list is printed on the bottle.</p>{{ note_html }}
{%- elsif text contains 'CLP label' -%}
<p>{{ text | escape }}</p>
{%- else -%}
{%- assign lines = text | newline_to_br | split: '<br />' -%}
{%- if lines.size > 1 -%}
{%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}
{%- assign name = l | split: ': ' | first -%}
{%- assign named = false -%}
{%- if name != l -%}{%- unless name contains ',' -%}{%- assign named = true -%}{%- endunless -%}{%- endif -%}
{%- if named -%}<p><strong>{{ name | escape }}:</strong> {{ l | remove_first: name | remove_first: ': ' | escape }}</p>{%- else -%}<p>{{ l | escape }}</p>{%- endif -%}
{%- endif -%}{%- endfor -%}{{ note_html }}
{%- else -%}
<p>{{ text | escape }}</p>{% if text contains '*' %}<p class="accordion-note">* Naturally occurring in essential oils.</p>{% endif %}{{ note_html }}
{%- endif -%}
{%- endif -%}

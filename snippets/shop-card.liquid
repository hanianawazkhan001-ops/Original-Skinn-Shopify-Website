{%- comment -%}
  A product card on the shop pages — copied from the test site.
  Params: product, order (position in the list)
{%- endcomment -%}
{%- liquid
  assign handles = product.collections | map: 'handle' | join: ' ' | prepend: ' ' | append: ' '
  assign cat_keys = ''
  assign cat_names = ''
  if handles contains ' face '
    assign cat_keys = cat_keys | append: ' face'
    assign cat_names = cat_names | append: '|Face'
  endif
  if handles contains ' body ' or handles contains ' body-and-hair '
    assign cat_keys = cat_keys | append: ' body'
    assign cat_names = cat_names | append: '|Body'
  endif
  if handles contains ' bath-shower ' or handles contains ' bath-and-shower '
    assign cat_keys = cat_keys | append: ' bath'
    assign cat_names = cat_names | append: '|Bath & Shower'
  endif
  if handles contains ' baby '
    assign cat_keys = cat_keys | append: ' baby'
    assign cat_names = cat_names | append: '|Baby'
  endif
  if handles contains ' home-fragrance '
    assign cat_keys = cat_keys | append: ' home'
    assign cat_names = cat_names | append: '|Home Fragrance'
  endif
  assign cat_label = cat_names | remove_first: '|' | replace: '|', ' · '
  if cat_label == blank
    assign cat_label = product.type
  endif
  assign v = product.selected_or_first_available_variant
  assign card_title = product.metafields.custom.card_title.value | default: product.title
-%}
<article class="shop-card" data-category="{{ cat_keys | strip }}" data-name="{{ card_title | downcase | escape }}" data-order="{{ order }}" data-price="{{ v.price | divided_by: 100.0 }}">
<div class="shop-image">
{%- if product.tags contains 'best-seller' %}
<span class="shop-badge">Best Seller</span>
{%- endif %}
<a class="card-media-link" href="{{ product.url }}" tabindex="-1" aria-hidden="true"><img loading="lazy" alt="{{ card_title | escape }}" src="{{ product.featured_image | image_url: width: 900 }}"/></a>
</div>
<div class="shop-copy">
<span class="shop-category">{{ cat_label }}</span>
<h2><a class="card-title-link" href="{{ product.url }}">{{ card_title }}</a></h2>
<p>{{ product.metafields.custom.tagline.value }}</p>
<div class="shop-bottom">
<strong>{{ v.price | money }}</strong>
<div class="card-actions"><button aria-label="Add {{ card_title | escape }} to bag" class="card-add" data-product="{{ card_title | escape }}" data-variants="{{ v.id }}" title="Add to bag" type="button"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 2.5 3.5 6v13.5A2 2 0 0 0 5.5 21.5h13a2 2 0 0 0 2-2V6L18 2.5z"/><path d="M3.5 6h17"/><path d="M15.5 10a3.5 3.5 0 0 1-7 0"/></svg></button></div>
</div>
</div>
</article>

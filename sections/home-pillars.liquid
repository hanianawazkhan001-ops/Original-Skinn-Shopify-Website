{%- comment -%}
  Home: the four tiles (Plant-led, Vegan, Independent, Safety assessed) — copied from the test site.
  Each tile is a block; the photo holds the circle, the words and the small icon sit on top.
{%- endcomment -%}
<section class="approved-card-section"><div class="approved-card-grid">
{%- for block in section.blocks -%}
<div class="approved-card pillar-card" {{ block.shopify_attributes }}>
{%- render 'os-img', image: block.settings.image, fallback: block.settings.fallback, alt: '', width: 1008, attrs: 'width="504" height="557"' -%}
<div class="pillar-layer">
{%- case block.settings.icon -%}
{%- when 'leaf' -%}<span class="pillar-icon" style="left:{{ block.settings.icon_left }}%;top:{{ block.settings.icon_top }}%"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 20.5C3.5 10 10 3.5 20.5 3.5c0 10.5-6.5 17-17 17z"/><path d="M3.5 20.5L13.5 10.5"/></svg></span>
{%- when 'shield' -%}<span class="pillar-icon" style="left:{{ block.settings.icon_left }}%;top:{{ block.settings.icon_top }}%"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2l6.8 2.7v5c0 4.9-3 8.3-6.8 9.9-3.8-1.6-6.8-5-6.8-9.9v-5z"/><path d="M8.9 12.1l2.2 2.2 4.1-4.4"/></svg></span>
{%- endcase -%}
<div class="pillar-text"><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div></div>
{%- endfor -%}
</div></section>

{% schema %}
{
  "name": "Home tiles",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Tile photo" },
        { "type": "text", "id": "fallback", "label": "Built-in photo (used when no photo is chosen)", "default": "pillar-plant-led.jpg" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Plant-led" },
        { "type": "text", "id": "text", "label": "Text", "default": "Skincare built around plant oils and butters." },
        { "type": "select", "id": "icon", "label": "Icon drawn on top of the photo", "default": "none",
          "options": [ { "value": "none", "label": "None (icon is in the photo)" }, { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" } ] },
        { "type": "number", "id": "icon_left", "label": "Icon position from left (%)", "default": 48.6 },
        { "type": "number", "id": "icon_top", "label": "Icon position from top (%)", "default": 24 }
      ]
    }
  ],
  "presets": [{ "name": "Home tiles" }]
}
{% endschema %}

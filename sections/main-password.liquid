<div class="container" style="padding:96px 28px 110px;text-align:center;max-width:560px">
  <p class="eyebrow">Coming soon</p>
  <h2>{{ settings.brand_name | default: shop.name }}</h2>
  {%- if shop.password_message != blank -%}<p style="margin-top:16px;color:var(--muted)">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label for="Password" style="display:block;margin:28px 0 8px;font-size:12px;letter-spacing:.14em;text-transform:uppercase">Enter store password</label>
    <input id="Password" type="password" name="password" autocomplete="current-password" style="width:100%;min-height:50px;border:1px solid var(--line);border-radius:999px;padding:0 20px">
    <button class="btn primary" type="submit" style="margin-top:14px;width:100%">Enter</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}

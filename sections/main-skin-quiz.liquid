{%- comment -%}
  Skin quiz page (/pages/skin-quiz, template page.skin-quiz).
  A few questions (face, body, bath or baby), then a step-by-step routine from our own range with
  "Add all to bag", plus an optional newsletter sign-up tagged with the quiz answer.
  The questions and which products each answer leads to are set in the script at the bottom
  (QUIZ and the pick… functions). Product names, photos, prices and links come from the products.
{%- endcomment -%}
{%- liquid
  assign handles = 'gentle-foaming-face-wash-chamomile-lavender,facial-toner-mist-spray,hyaluronic-acid-facial-serum-cranberry-grapefruit-raspberry,original-skinn-light-moisturiser-serum-unfragranced-50ml,original-skinn-rich-moisturiser-serum-lemon-cedarwood-50ml,face-ritual-cleanse-refresh-moisturise,day-night-face-ritual-complete-face-routine,sweet-citrus-salt-scrub,rose-petal-salt-scrub,vanilla-bliss-salt-scrub,lavender-salt-scrub,sweet-orange-body-butter,rose-whipped-body-butter,original-shea-body-butter,lavender-fragranced-whipped-body-butter,candy-cane-whipped-body-butter-winter-rituals-collection,citrus-skin-nourishing-balm,geranium-rose-skin-nourishing-balm,lavender-skin-nourishing-balm,rosemary-skin-and-beard-nourishing-balm,ginger-lemon-orange-bath-soak,rose-petal-bath-salt,lavender-bliss-bath-salt,citrus-spice-soy-wax-candle,shimmer-velvet-soy-wax-candle,steamy-romance-shower-steamer,hangover-shower-steamer,mandarin-geranium-shower-gel,original-skinn-all-natural-gentle-soothing-baby-wash-100ml,original-skinn-all-natural-soothing-baby-moisturiser-100ml,original-skinn-bedtime-bundle-gentle-wash-soothing-moisturiser,ultimate-spa-ritual-set' | split: ','
  assign hero_heading = section.settings.hero_heading | default: page.title
-%}
{%- render 'page-hero', style: 'faq', kicker: section.settings.hero_kicker, heading: hero_heading, text: section.settings.hero_text -%}

<section class="sq-shell" data-skin-quiz>
  <div class="sq-card">
    <div class="sq-top" data-sq-top hidden>
      <button type="button" class="sq-back" data-sq-back>&larr; Back</button>
      <span class="sq-count" data-sq-count></span>
    </div>
    <div class="sq-progress" aria-hidden="true"><span data-sq-bar></span></div>

    <div class="sq-step" data-sq-question aria-live="polite">
      <h2 class="sq-q" data-sq-q tabindex="-1">{{ section.settings.first_question }}</h2>
      <p class="sq-help" data-sq-help></p>
      <div class="sq-options" data-sq-options></div>
      <noscript><p class="sq-help">Please turn on JavaScript to use the quiz, or browse our <a href="{{ routes.all_products_collection_url }}">full range</a>.</p></noscript>
    </div>

    <div class="sq-result" data-sq-result hidden>
      <span class="sq-kicker">Your routine</span>
      <h2 class="sq-q" data-sq-rtitle tabindex="-1"></h2>
      <p class="sq-help" data-sq-rintro></p>
      <ol class="sq-steps" data-sq-steps></ol>
      <p class="sq-tip" data-sq-tip hidden></p>
      <div class="sq-buy" data-sq-buy>
        <div class="sq-buy-text"><span class="sq-buy-label" data-sq-buy-label></span><strong class="sq-buy-price" data-sq-buy-price></strong></div>
        <button type="button" class="btn primary concern-add sq-add" data-sq-add data-product="" data-variants="">Add all to bag</button>
        <div class="sq-alt" data-sq-alt></div>
      </div>
      <p class="sq-note">{{ section.settings.result_note }}</p>
      <button type="button" class="sq-restart" data-sq-restart>Start again</button>

      {%- if section.settings.show_signup -%}
      <div class="sq-signup">
        <h3>{{ section.settings.signup_heading }}</h3>
        <p>{{ section.settings.signup_text }}</p>
        {%- form 'customer', class: 'signup sq-form', id: 'sqSignup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,skin-quiz" data-sq-tags>
        <label class="visually-hidden" for="sqEmail">Email address</label>
        <input id="sqEmail" autocomplete="email" placeholder="Your email address" required type="email" name="contact[email]"/>
        <button type="submit">{{ section.settings.signup_button }}</button>
        {%- if form.posted_successfully? -%}{%- assign sq_msg = section.settings.signup_success -%}{%- assign sq_posted = true -%}{%- elsif form.errors -%}{%- assign sq_msg = 'Please check your email address and try again.' -%}{%- assign sq_posted = true -%}{%- endif -%}
        {%- endform -%}
        <div class="signup-msg" role="status" data-sq-posted="{% if sq_posted %}true{% endif %}">{{ sq_msg }}</div>
        <p class="signup-privacy">See our <a href="{{ section.settings.privacy_link }}">Privacy Policy</a>.</p>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script type="application/json" id="sqProducts">{
{%- comment -%} Looked up through the Shop All collection: Shopify's all_products only answers 20 products per page {%- endcomment -%}
{%- paginate collections.all.products by 250 -%}
{%- for p in collections.all.products -%}
{%- if handles contains p.handle -%}
{%- capture pn -%}{% render 'product-name', product: p, part: 'short' %}{%- endcapture -%}
{{ p.handle | json }}:{"n":{{ pn | strip | json }},"u":{{ p.url | json }},"i":{{ p.featured_image | image_url: width: 240 | json }},"p":{{ p.selected_or_first_available_variant.price | default: 0 }},"cp":{{ p.selected_or_first_available_variant.compare_at_price | default: 0 }},"v":{{ p.selected_or_first_available_variant.id | default: 0 }},"a":{{ p.available | json }}},
{%- endif -%}
{%- endfor -%}
{%- endpaginate -%}
}</script>

<script>
(function(){
  var root = document.querySelector('[data-skin-quiz]');
  if(!root || root.dataset.ready) return; root.dataset.ready = '1';
  var P = {};
  try { P = JSON.parse(document.getElementById('sqProducts').textContent.replace(/,\s*}$/, '}')); } catch(e) { P = {}; }

  var H = {
    wash:'gentle-foaming-face-wash-chamomile-lavender', mist:'facial-toner-mist-spray',
    serum:'hyaluronic-acid-facial-serum-cranberry-grapefruit-raspberry',
    day:'original-skinn-light-moisturiser-serum-unfragranced-50ml', night:'original-skinn-rich-moisturiser-serum-lemon-cedarwood-50ml',
    faceRitual:'face-ritual-cleanse-refresh-moisturise', dayNight:'day-night-face-ritual-complete-face-routine',
    gel:'mandarin-geranium-shower-gel', spaSet:'ultimate-spa-ritual-set',
    babyWash:'original-skinn-all-natural-gentle-soothing-baby-wash-100ml', babyMoist:'original-skinn-all-natural-soothing-baby-moisturiser-100ml',
    babyBundle:'original-skinn-bedtime-bundle-gentle-wash-soothing-moisturiser'
  };
  // the product for each scent family
  var SCENT = {
    citrus:   {scrub:'sweet-citrus-salt-scrub', butter:'sweet-orange-body-butter', balm:'citrus-skin-nourishing-balm', soak:'ginger-lemon-orange-bath-soak', candle:'citrus-spice-soy-wax-candle', steamer:'hangover-shower-steamer'},
    floral:   {scrub:'rose-petal-salt-scrub', butter:'rose-whipped-body-butter', balm:'geranium-rose-skin-nourishing-balm', soak:'rose-petal-bath-salt', candle:'shimmer-velvet-soy-wax-candle', steamer:'steamy-romance-shower-steamer'},
    warm:     {scrub:'vanilla-bliss-salt-scrub', butter:'original-shea-body-butter', balm:'citrus-skin-nourishing-balm', soak:'ginger-lemon-orange-bath-soak', candle:'citrus-spice-soy-wax-candle', steamer:'steamy-romance-shower-steamer'},
    lavender: {scrub:'lavender-salt-scrub', butter:'lavender-fragranced-whipped-body-butter', balm:'lavender-skin-nourishing-balm', soak:'lavender-bliss-bath-salt', candle:'shimmer-velvet-soy-wax-candle', steamer:'steamy-romance-shower-steamer'},
    mint:     {scrub:'sweet-citrus-salt-scrub', butter:'candy-cane-whipped-body-butter-winter-rituals-collection', balm:'rosemary-skin-and-beard-nourishing-balm', soak:'ginger-lemon-orange-bath-soak', candle:'citrus-spice-soy-wax-candle', steamer:'hangover-shower-steamer'}
  };
  var SCENT_Q = {id:'scent', q:'Which scent do you like best?', help:'We’ll match the scrub, butter and the rest to it.', options:[
    {v:'citrus', l:'Fresh & citrus', d:'Grapefruit, sweet orange, ginger'},
    {v:'floral', l:'Floral', d:'Rose, geranium, ylang ylang'},
    {v:'warm', l:'Warm & sweet', d:'Vanilla and warm spice'},
    {v:'lavender', l:'Lavender', d:'Soft and floral'},
    {v:'mint', l:'Cool & minty', d:'Peppermint and fresh herbs'}
  ]};

  var QUIZ = {
    area: {id:'area', q:'What are you looking for?', help:'Pick one. You can always take the quiz again for another.', options:[
      {v:'face', l:'Face', d:'Cleanse, mist, serum and moisturise'},
      {v:'body', l:'Body', d:'Scrubs, butters and balms'},
      {v:'bath', l:'Bath & shower', d:'Soaks, scrubs, steamers and candles'},
      {v:'baby', l:'Baby', d:'Gentle wash and moisturiser'}
    ]},
    face: [
      {id:'feel', q:'How does your face usually feel by midday?', options:[
        {v:'dry', l:'Tight or dry', d:'Especially after washing'},
        {v:'normal', l:'Comfortable', d:'Not dry, not shiny'},
        {v:'combo', l:'Shiny in places', d:'Usually the forehead, nose and chin'},
        {v:'oily', l:'Shiny all over', d:'By the afternoon'}
      ]},
      {id:'when', q:'When do you want a routine for?', options:[
        {v:'am', l:'Mornings', d:'A quick start to the day'},
        {v:'pm', l:'Evenings', d:'Wind down before bed'},
        {v:'both', l:'Morning and night', d:'The full routine'}
      ]},
      {id:'fragrance', q:'How do you feel about scent in face products?', options:[
        {v:'free', l:'No added fragrance, please', d:'We’ll only show unscented picks'},
        {v:'ok', l:'A light natural scent is fine', d:'Lavender, chamomile, lemon and cedarwood'}
      ]}
    ],
    body: [
      {id:'goal', q:'What would you like from your body routine?', options:[
        {v:'smooth', l:'Smoother skin', d:'Buff away dry, rough bits'},
        {v:'soft', l:'Soft skin all over', d:'Wash, then moisturise'},
        {v:'spots', l:'Help with dry spots', d:'Hands, elbows, knees, cuticles'},
        {v:'full', l:'The full routine', d:'Scrub, wash, butter and balm'}
      ]},
      SCENT_Q
    ],
    bath: [
      {id:'type', q:'Bath or shower?', options:[
        {v:'bath', l:'A long bath', d:'Candle, scrub, soak and butter'},
        {v:'shower', l:'A quick shower', d:'Steamer, scrub, wash and butter'}
      ]},
      SCENT_Q
    ],
    baby: [
      {id:'age', q:'How old is your little one?', help:'Our baby products are safety assessed from a certain age, so this helps us show the right ones.', options:[
        {v:'u3', l:'Under 3 months'},
        {v:'3to6', l:'3 to 6 months'},
        {v:'6plus', l:'6 months or older'}
      ]}
    ]
  };

  function money(c){ c = Number(c) || 0; var s = (c / 100).toFixed(2); return '£' + s.replace(/\.00$/, ''); }
  function step(label, key, when){ return {label:label, h:key, when:when || ''}; }

  // ---- what each set of answers leads to ----
  function pickFace(a){
    var r = {title:'Your face routine', steps:[], tip:'', buy:null, alt:[]};
    var tips = {
      dry:'Your skin feels tight by midday, so use the serum morning and night and don’t skip moisturiser.',
      normal:'Keep it simple: the same few steps every day.',
      combo:'Use a little less moisturiser on the shinier areas.',
      oily:'The serum is a light gel, so it won’t feel heavy. A small amount of moisturiser is plenty.'
    };
    r.tip = tips[a.feel] || '';
    if(a.fragrance === 'free'){
      r.intro = 'Our two face products with no added fragrance.';
      r.steps.push(step('Serum', H.serum, a.when === 'am' ? 'Mornings' : (a.when === 'pm' ? 'Evenings' : 'Morning & night')));
      if(a.when !== 'pm') r.steps.push(step('Moisturise', H.day, 'Mornings'));
      r.note2 = 'Our face wash, toner mist and Night Moisturiser are lightly scented with essential oils, so we’ve left them out.';
      r.buy = {label:'Add ' + (r.steps.length > 1 ? 'both' : 'it'), keys:r.steps.map(function(s){ return s.h; })};
      return r;
    }
    r.steps.push(step('Cleanse', H.wash, a.when === 'both' ? 'Morning & night' : ''));
    r.steps.push(step('Mist', H.mist, a.when === 'both' ? 'Morning & night' : ''));
    r.steps.push(step('Serum', H.serum, a.when === 'both' ? 'Morning & night' : ''));
    if(a.when !== 'pm') r.steps.push(step('Moisturise', H.day, a.when === 'both' ? 'Mornings' : ''));
    if(a.when !== 'am') r.steps.push(step('Moisturise', H.night, a.when === 'both' ? 'Evenings' : ''));
    if(a.when === 'am'){
      r.intro = 'A quick morning routine: cleanse, mist, serum, then the Day Moisturiser.';
      r.buy = {label:'Face Ritual (all 4 steps)', keys:[H.faceRitual]};
    } else if(a.when === 'pm'){
      r.intro = 'An evening routine: cleanse, mist, serum, then the Night Moisturiser.';
      r.buy = {label:'All 4 products', keys:[H.wash, H.mist, H.serum, H.night]};
    } else {
      r.intro = 'Cleanse, mist and serum morning and night, with the Day Moisturiser in the morning and the Night Moisturiser before bed.';
      r.buy = {label:'Day & Night Face Ritual + serum', keys:[H.dayNight, H.serum]};
      r.alt.push({label:'Just the Day & Night Face Ritual', keys:[H.dayNight]});
    }
    return r;
  }
  function pickBody(a){
    var s = SCENT[a.scent] || SCENT.citrus, r = {title:'Your body routine', steps:[], alt:[]};
    var scrub = step('Scrub', s.scrub, '2–3 times a week'), wash = step('Wash', H.gel, 'In the shower'),
        butter = step('Moisturise', s.butter, 'After your shower'), balm = step('Dry spots', s.balm, 'Whenever they need it');
    if(a.goal === 'smooth'){ r.steps = [scrub, butter]; r.intro = 'Scrub in the shower, then smooth on whipped butter.'; }
    else if(a.goal === 'soft'){ r.steps = [wash, butter]; r.intro = 'Wash, then smooth on whipped butter while your skin is still a little damp.'; }
    else if(a.goal === 'spots'){ r.steps = [butter, balm]; r.intro = 'Whipped butter all over, then a little balm on the dry spots.'; }
    else { r.steps = [scrub, wash, butter, balm]; r.intro = 'The full routine: scrub, wash, butter, and balm for dry spots.'; }
    r.buy = {label:'All ' + r.steps.length + ' products', keys:r.steps.map(function(x){ return x.h; })};
    r.tip = 'Every butter comes in 50, 100 and 200 ml. We’ve added the 50 ml; you can change the size on its page.';
    return r;
  }
  function pickBath(a){
    var s = SCENT[a.scent] || SCENT.citrus, r = {title:'Your bath & shower routine', steps:[], alt:[]};
    if(a.type === 'bath'){
      r.steps = [step('Set the mood', s.candle, 'Light it before you run the bath'), step('Scrub', s.scrub, 'Before you soak'), step('Soak', s.soak, '2–3 teaspoons under warm running water'), step('Moisturise', s.butter, 'After your bath')];
      r.intro = 'Light a candle, scrub, soak, then moisturise.';
      r.link = {label:'Or choose your scrub, soak and butter in the Ultimate Spa Ritual Set', h:H.spaSet};
    } else {
      r.steps = [step('Steam', s.steamer, 'On the shower floor, away from the water'), step('Scrub', s.scrub, '2–3 times a week'), step('Wash', H.gel, 'Every shower'), step('Moisturise', s.butter, 'After your shower')];
      r.intro = 'A shower steamer for the scent, then scrub, wash and moisturise.';
    }
    r.buy = {label:'All ' + r.steps.length + ' products', keys:r.steps.map(function(x){ return x.h; })};
    return r;
  }
  function pickBaby(a){
    var r = {title:'Your baby routine', steps:[], alt:[]};
    if(a.age === 'u3'){
      r.intro = 'Our baby wash is safety assessed from 3 months and the moisturiser from 6 months, so we don’t have a pick for your little one just yet.';
      r.none = true; r.link = {label:'Browse our baby range', url:'/collections/baby'}; return r;
    }
    r.steps.push(step('Bath time', H.babyWash, 'From 3 months'));
    if(a.age === '6plus'){
      r.steps.push(step('Moisturise', H.babyMoist, 'From 6 months'));
      r.intro = 'A gentle wash at bath time, then a little moisturiser on clean, dry skin.';
      r.buy = {label:'Baby Essentials Bundle', keys:[H.babyBundle]};
    } else {
      r.intro = 'A gentle wash at bath time. Our moisturiser is safety assessed from 6 months, so add it later.';
      r.buy = {label:'Add the baby wash', keys:[H.babyWash]};
    }
    return r;
  }

  // ---- the quiz itself ----
  var el = function(s){ return root.querySelector(s); };
  var qEl = el('[data-sq-q]'), helpEl = el('[data-sq-help]'), optsEl = el('[data-sq-options]'), barEl = el('[data-sq-bar]'),
      topEl = el('[data-sq-top]'), countEl = el('[data-sq-count]'), questionEl = el('[data-sq-question]'), resultEl = el('[data-sq-result]');
  var answers = {}, path = [], pos = 0;
  function questions(){ return answers.area ? [QUIZ.area].concat(QUIZ[answers.area]) : [QUIZ.area]; }
  function total(){ return answers.area ? questions().length : 3; }

  function render(focus){
    var qs = questions(), q = qs[pos];
    questionEl.hidden = false; resultEl.hidden = true;
    topEl.hidden = pos === 0;
    countEl.textContent = 'Question ' + (pos + 1) + ' of ' + total();
    barEl.style.width = Math.round(pos / (total() + 0) * 100) + '%';
    qEl.textContent = q.q;
    helpEl.textContent = q.help || ''; helpEl.hidden = !q.help;
    optsEl.innerHTML = '';
    q.options.forEach(function(o){
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'sq-opt' + (answers[q.id] === o.v ? ' is-picked' : '');
      b.setAttribute('aria-pressed', answers[q.id] === o.v ? 'true' : 'false');
      var t = document.createElement('span'); t.className = 'sq-opt-l'; t.textContent = o.l; b.appendChild(t);
      if(o.d){ var d = document.createElement('span'); d.className = 'sq-opt-d'; d.textContent = o.d; b.appendChild(d); }
      b.addEventListener('click', function(){
        if(q.id === 'area' && answers.area !== o.v){ answers = {}; }
        answers[q.id] = o.v;
        if(pos + 1 < questions().length){ pos++; render(true); } else { showResult(true); }
      });
      optsEl.appendChild(b);
    });
    if(focus) qEl.focus({preventScroll:true});
    if(focus) scrollTop();
  }
  function scrollTop(){
    var r = root.getBoundingClientRect();
    if(r.top < 0) root.scrollIntoView({behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block:'start'});
  }

  function showResult(focus){
    var fn = {face:pickFace, body:pickBody, bath:pickBath, baby:pickBaby}[answers.area];
    var r = fn(answers);
    questionEl.hidden = true; resultEl.hidden = false;
    topEl.hidden = false; countEl.textContent = 'Your results';
    barEl.style.width = '100%';
    el('[data-sq-rtitle]').textContent = r.title;
    el('[data-sq-rintro]').textContent = r.intro || '';
    var list = el('[data-sq-steps]'); list.innerHTML = '';
    list.hidden = !r.steps.length;
    var n = 0;
    r.steps.forEach(function(s){
      var p = P[s.h]; if(!p) return; n++;
      var li = document.createElement('li'); li.className = 'sq-item';
      li.innerHTML = '<a class="sq-item-pic" href="" tabindex="-1" aria-hidden="true"><img alt="" loading="lazy" width="72" height="72"></a>' +
        '<div class="sq-item-text"><span class="sq-item-step"></span><a class="sq-item-name" href=""></a><span class="sq-item-meta"></span></div>';
      li.querySelector('.sq-item-pic').href = p.u; li.querySelector('img').src = p.i;
      li.querySelector('.sq-item-step').textContent = (n < 10 ? '0' + n : n) + '  ' + s.label;
      var a = li.querySelector('.sq-item-name'); a.href = p.u; a.textContent = (/candle/.test(s.h) && !/candle/i.test(p.n)) ? p.n + ' Soy Wax Candle' : p.n;
      li.querySelector('.sq-item-meta').textContent = money(p.p) + (s.when ? ' · ' + s.when : '');
      list.appendChild(li);
    });
    var tip = el('[data-sq-tip]'); var tipText = [r.tip, r.note2].filter(Boolean).join(' ');
    tip.textContent = tipText; tip.hidden = !tipText;
    var buyBox = el('[data-sq-buy]'), add = el('[data-sq-add]'), alt = el('[data-sq-alt]');
    alt.innerHTML = '';
    el('.sq-buy-text') && (root.querySelector('.sq-buy-text').hidden = !!r.none);
    if(r.none && r.link){ buyBox.hidden = false; el('[data-sq-buy-label]').textContent = ''; el('[data-sq-buy-price]').textContent = ''; add.hidden = true;
      var bl = document.createElement('a'); bl.className = 'sq-alt-link'; bl.href = r.link.url; bl.textContent = r.link.label + ' →'; alt.appendChild(bl); }
    else if(!r.buy){ buyBox.hidden = true; }
    else {
      buyBox.hidden = false; add.hidden = false;
      var ids = [], sum = 0, was = 0, names = [];
      r.buy.keys.forEach(function(k){ var p = P[k]; if(p && p.v){ ids.push(p.v); sum += p.p; was += (p.cp > p.p ? p.cp : p.p); names.push(p.n); } });
      el('[data-sq-buy-label]').textContent = r.buy.label;
      el('[data-sq-buy-price]').innerHTML = (was > sum ? '<s>' + money(was) + '</s> ' : '') + money(sum);
      add.dataset.variants = ids.join(','); add.dataset.product = names.join(' + ');
      add.disabled = !ids.length;
      (r.alt || []).forEach(function(o){
        var aIds = [], aSum = 0, aNames = [];
        o.keys.forEach(function(k){ var p = P[k]; if(p && p.v){ aIds.push(p.v); aSum += p.p; aNames.push(p.n); } });
        if(!aIds.length) return;
        var b = document.createElement('button'); b.type = 'button'; b.className = 'sq-alt-btn concern-add';
        b.dataset.variants = aIds.join(','); b.dataset.product = aNames.join(' + ');
        b.textContent = o.label + ', ' + money(aSum); alt.appendChild(b);
      });
      if(r.link && P[r.link.h]){
        var l = document.createElement('a'); l.className = 'sq-alt-link'; l.href = P[r.link.h].u;
        l.textContent = r.link.label + ' (' + money(P[r.link.h].p) + ') →'; alt.appendChild(l);
      }
    }
    var tags = el('[data-sq-tags]');
    if(tags) tags.value = 'newsletter,skin-quiz,skin-quiz-' + answers.area;
    if(focus){ el('[data-sq-rtitle]').focus({preventScroll:true}); scrollTop(); }
  }

  el('[data-sq-back]').addEventListener('click', function(){
    if(!resultEl.hidden){ render(true); return; }
    if(pos > 0){ pos--; render(true); }
  });
  el('[data-sq-restart]').addEventListener('click', function(){ answers = {}; pos = 0; render(true); });

  // keep the answers across the sign-up form's page reload, so the results are still there afterwards
  var form = root.querySelector('.sq-form');
  if(form) form.addEventListener('submit', function(){ try { sessionStorage.setItem('osSkinQuiz', JSON.stringify(answers)); } catch(e){} });
  var posted = root.querySelector('[data-sq-posted="true"]'), restored = false;
  if(posted){
    try { var saved = JSON.parse(sessionStorage.getItem('osSkinQuiz') || 'null'); if(saved && saved.area){ answers = saved; pos = questions().length - 1; showResult(false); restored = true; } } catch(e){}
    if(restored) posted.scrollIntoView({block:'center'});
  }
  if(!restored) render(false);
})();
</script>


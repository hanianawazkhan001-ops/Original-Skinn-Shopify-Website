{%- comment -%}
  Home: "What customers say" — copied from the test site.
  NOTE: these three quotes come from the test site. Before launch they must be replaced by real
  customer reviews (DMCC Act): either type in genuine reviews, or add the reviews app's block
  (e.g. Judge.me "Reviews carousel") to this section — when an app block is added, it replaces
  the typed quotes.
{%- endcomment -%}
{%- liquid
  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor
-%}
<section class="section reviews"><div class="container"><h2>{{ section.settings.heading }}</h2>
{%- if app_blocks > 0 -%}
{% render 'reviews-style' %}
<div class="os-app-reviews">{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}</div>
{%- else -%}
<div class="review-grid">
{%- for block in section.blocks -%}
<article class="review{% if forloop.first %} featured{% endif %}" {{ block.shopify_attributes }}><blockquote>“{{ block.settings.quote }}”</blockquote><small>{{ block.settings.name }}</small></article>
{%- endfor -%}
</div>
{%- endif -%}
</div></section>

{% schema %}
{
  "name": "Customer reviews",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "After just a few weeks, my skin felt softer, healthier and more hydrated." },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Sarah Johnson" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Customer reviews" }]
}
{% endschema %}

{%- comment -%}
  Header, slide-out menu and bag icon — copied from the test site (index.html).
  Menus: choose a Shopify menu in the theme editor; until one is chosen, the
  test site's links are shown.
  On computers (wider than 1000px) the same links show as tabs either side of the logo
  instead of the ☰ menu: shop links on the left, information links (About, FAQs, Contact)
  on the right. Tablets and phones keep the ☰ menu. Turn the tabs off in the theme editor.
{%- endcomment -%}
{%- if section.settings.desktop_tabs -%}
<style>
  /* Computer menu tabs, either side of the logo. A small script below (DeskTabs) checks
     they fit at every width: if not, it first tightens the spacing, then falls back to the ☰ menu. */
  .desk-tabs{display:none}
  @media (min-width:1001px){
    .header .menu-left{visibility:hidden!important}
    .desk-tabs{--logo-half:35px;--logo-space:clamp(26px,2.6vw,44px);--tab-gap:clamp(18px,1.9vw,30px);display:block;position:absolute;inset:0;pointer-events:none;font-size:13px;letter-spacing:.02em}
    .desk-tabs-side{position:absolute;top:50%;transform:translateY(-50%);display:flex;align-items:center;gap:var(--tab-gap);white-space:nowrap;pointer-events:auto}
    .desk-tabs-side--left{right:calc(50% + var(--logo-half) + var(--logo-space))}
    .desk-tabs-side--right{left:calc(50% + var(--logo-half) + var(--logo-space))}
    .desk-tabs a{position:relative;color:var(--forest);text-decoration:none;padding:8px 0;white-space:nowrap}
    .desk-tabs a::after{content:"";position:absolute;left:0;right:100%;bottom:3px;height:1px;background:var(--forest);transition:right .25s ease}
    .desk-tabs a:hover::after,.desk-tabs a[aria-current="page"]::after{right:0}
    .desk-tabs a[aria-current="page"]{font-weight:600}
    .desk-tabs a:focus-visible{outline:2px solid var(--forest);outline-offset:4px;border-radius:2px}
    .desk-tabs a.is-info{color:var(--muted,#5f6d66)}
    html.os-tabs-compact .desk-tabs{--tab-gap:14px;--logo-space:22px;font-size:12px;letter-spacing:0}
    html.os-tabs-off .desk-tabs{display:none}
    html.os-tabs-off .header .menu-left{visibility:visible!important}
  }
  @media (min-width:1001px) and (hover:none){.desk-tabs a:hover::after{right:100%}.desk-tabs a[aria-current="page"]::after{right:0}}
  @media (min-width:1001px) and (prefers-reduced-motion:reduce){.desk-tabs a::after{transition:none}}
</style>
{%- endif -%}
<header class="header"><div class="nav">
<nav class="nav-left"><button aria-label="Open menu" class="nav-icon menu-left" id="menuOpenBtn" type="button">&#9776;</button></nav>
<a class="brand" href="{{ routes.root_url }}"><img alt="{{ settings.brand_name | default: 'Original Skinn' | escape }} logo" src="{{ 'logo.png' | asset_url }}" width="165" height="165"/></a>
{%- if section.settings.desktop_tabs -%}
<nav class="desk-tabs" aria-label="Main menu">
  <div class="desk-tabs-side desk-tabs-side--left">
  {%- if section.settings.menu_shop != blank -%}
    {%- for link in linklists[section.settings.menu_shop].links -%}
    <a href="{{ link.url }}"{% if link.current or request.path == link.url %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  {%- else -%}
    {%- liquid
      assign c = routes.collections_url
      assign urls = routes.all_products_collection_url | append: '|' | append: c | append: '/face|' | append: c | append: '/body|' | append: c | append: '/bath-shower|' | append: c | append: '/baby|' | append: c | append: '/home-fragrance|' | append: c | append: '/aromatherapy' | split: '|'
      assign titles = 'Shop All|Face|Body|Bath & Shower|Baby|Home Fragrance|Aromatherapy' | split: '|'
    -%}
    {%- for u in urls -%}
    <a href="{{ u }}"{% if request.path == u %} aria-current="page"{% endif %}>{{ titles[forloop.index0] | escape }}</a>
    {%- endfor -%}
  {%- endif -%}
  </div>
  <div class="desk-tabs-side desk-tabs-side--right">
  {%- if section.settings.menu_info != blank -%}
    {%- for link in linklists[section.settings.menu_info].links -%}
    <a class="is-info" href="{{ link.url }}"{% if link.current or request.path == link.url %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  {%- else -%}
    <a class="is-info" href="/pages/about"{% if request.path == '/pages/about' %} aria-current="page"{% endif %}>About Us</a>
    <a class="is-info" href="/pages/faqs"{% if request.path == '/pages/faqs' %} aria-current="page"{% endif %}>FAQs</a>
    <a class="is-info" href="/pages/contact"{% if request.path == '/pages/contact' %} aria-current="page"{% endif %}>Contact</a>
  {%- endif -%}
  </div>
</nav>
{%- endif -%}
<div class="nav-right">
  <button aria-label="Search" aria-expanded="false" aria-controls="searchPanel" class="nav-icon search-right" id="searchOpenBtn" type="button"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.6-3.6"></path></svg></button>
  <a aria-label="Bag" class="nav-icon cart-right" id="cartBtn" href="{{ routes.cart_url }}"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5h2l2.1 10.2a1 1 0 0 0 1 .8h8.9a1 1 0 0 0 1-.8L20 8H7"></path><circle cx="10" cy="19" r="1.6"></circle><circle cx="17" cy="19" r="1.6"></circle></svg><span class="bag-count" id="bagCount">{{ cart.item_count }}</span></a>
</div>
</div>
{%- capture search_links -%}
  {%- if section.settings.menu_shop != blank -%}
    {%- for link in linklists[section.settings.menu_shop].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}">Shop All</a><a href="{{ routes.collections_url }}/face">Face</a><a href="{{ routes.collections_url }}/body">Body</a><a href="{{ routes.collections_url }}/bath-shower">Bath &amp; Shower</a><a href="{{ routes.collections_url }}/baby">Baby</a><a href="{{ routes.collections_url }}/home-fragrance">Home Fragrance</a><a href="{{ routes.collections_url }}/aromatherapy">Aromatherapy</a>
  {%- endif -%}
{%- endcapture -%}
{%- render 'header-search', links: search_links -%}
</header>

{%- if section.settings.desktop_tabs -%}
<script>
  (function () {
    /* Keeps the computer menu tabs tidy either side of the logo at every screen width.
       full    – normal spacing
       compact – tighter spacing and slightly smaller text when the full tabs don't fit
       off     – the ☰ menu instead, when even the compact tabs don't fit
       "Fit" means: each side on one line, clear of the logo, the screen edge and the search and bag icons. */
    class DeskTabs {
      constructor(root) {
        this.root = root;
        this.left = root.querySelector('.desk-tabs-side--left');
        this.right = root.querySelector('.desk-tabs-side--right');
        this.header = root.closest('.header');
        this.nav = root.closest('.nav');
        this.logo = this.header.querySelector('.brand img');
        this.icons = this.header.querySelector('.nav-right');
        this.html = document.documentElement;
        this.query = window.matchMedia('(min-width: 1001px)');
        this.space = 14; /* the least room to keep between the tabs and the logo, icons or edge */
        this.schedule = this.schedule.bind(this);
        if ('ResizeObserver' in window) new ResizeObserver(this.schedule).observe(this.nav);
        window.addEventListener('resize', this.schedule);
        if (this.query.addEventListener) this.query.addEventListener('change', this.schedule);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(this.schedule);
        this.fit();
      }
      schedule() {
        clearTimeout(this.timer);
        this.timer = setTimeout(() => this.fit(), 60);
      }
      setMode(mode) {
        this.html.classList.toggle('os-tabs-compact', mode === 'compact');
        this.html.classList.toggle('os-tabs-off', mode === 'off');
      }
      oneLine(side) {
        const links = side.querySelectorAll('a');
        if (!links.length) return true;
        const top = links[0].getBoundingClientRect().top;
        return Array.prototype.every.call(links, (a) => Math.abs(a.getBoundingClientRect().top - top) < 2);
      }
      fits() {
        if (!this.left.children.length && !this.right.children.length) return false;
        const nav = this.nav.getBoundingClientRect();
        const logo = this.logo.getBoundingClientRect();
        const icons = this.icons.getBoundingClientRect();
        const left = this.left.getBoundingClientRect();
        const right = this.right.getBoundingClientRect();
        const s = this.space;
        return this.oneLine(this.left) && this.oneLine(this.right) &&
          left.left >= nav.left + s && left.right <= logo.left - s &&
          right.left >= logo.right + s && right.right <= icons.left - s;
      }
      fit() {
        if (!this.query.matches) {
          this.setMode('full');
          return;
        }
        this.setMode('full');
        if (!this.fits()) {
          this.setMode('compact');
          if (!this.fits()) this.setMode('off');
        }
      }
    }
    const tabs = document.querySelector('.desk-tabs');
    if (tabs) {
      window.OriginalSkinn = window.OriginalSkinn || {};
      window.OriginalSkinn.deskTabs = new DeskTabs(tabs);
    }
  })();
</script>
{%- endif -%}

<div class="menu-overlay" id="menuOverlay" aria-hidden="true"></div>
<aside class="menu-drawer" id="menuDrawer" aria-hidden="true" aria-label="Main menu">
  <div class="menu-drawer-head">
    <div class="menu-mini-brand"><img src="{{ 'logo.png' | asset_url }}" alt="{{ settings.brand_name | default: 'Original Skinn' | escape }}" width="165" height="165"><strong>{{ settings.brand_name | default: 'Original Skinn' }}</strong></div>
    <button class="menu-close" id="menuClose" type="button" aria-label="Close menu">
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="menu-inner">
    <div class="menu-eyebrow">{{ section.settings.menu_eyebrow }}</div>
    <nav class="menu-primary" aria-label="Shop categories">
      {%- if section.settings.menu_shop != blank -%}
        {%- for link in linklists[section.settings.menu_shop].links -%}
      <a href="{{ link.url }}">{{ link.title }} <span class="arrow">&rarr;</span></a>
        {%- endfor -%}
      {%- else -%}
      <a href="{{ routes.all_products_collection_url }}">Shop All <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/face">Face <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/body">Body <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/bath-shower">Bath &amp; Shower <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/baby">Baby <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/home-fragrance">Home Fragrance <span class="arrow">&rarr;</span></a>
      <a href="{{ routes.collections_url }}/aromatherapy">Aromatherapy <span class="arrow">&rarr;</span></a>
      {%- endif -%}
    </nav>
    <div class="menu-divider"></div>
    <nav class="menu-secondary" aria-label="Information">
      {%- if section.settings.menu_info != blank -%}
        {%- for link in linklists[section.settings.menu_info].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
      <a href="/pages/about">About Us</a>
      <a href="/pages/faqs">FAQs</a>
      <a href="/pages/contact">Contact</a>
      {%- endif -%}
    </nav>
    <div class="menu-spacer"></div>
    <a class="menu-best" href="{{ section.settings.menu_button_link | default: routes.all_products_collection_url }}">{{ section.settings.menu_button_label }} &rarr;</a>
    <div class="menu-note">{{ section.settings.menu_note }}</div>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "class": "os-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Computer menu" },
    { "type": "checkbox", "id": "desktop_tabs", "label": "Show the menu as tabs on computers", "default": true, "info": "Tabs appear either side of the logo on screens wider than 1000px, using the same links as the slide-out menu: shop links on the left, information links on the right. Tablets and phones keep the ☰ menu." },
    { "type": "header", "content": "Slide-out menu" },
    { "type": "text", "id": "menu_eyebrow", "label": "Small heading", "default": "Shop by ritual" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop links menu", "info": "Leave empty to show the standard shop links." },
    { "type": "link_list", "id": "menu_info", "label": "Information links menu", "info": "Leave empty to show About Us, FAQs and Contact." },
    { "type": "text", "id": "menu_button_label", "label": "Button label", "default": "Shop All" },
    { "type": "url", "id": "menu_button_link", "label": "Button link" },
    { "type": "text", "id": "menu_note", "label": "Note at the bottom", "default": "Natural skincare, thoughtfully made." }
  ]
}
{% endschema %}

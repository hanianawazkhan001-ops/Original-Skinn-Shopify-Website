{%- comment -%}
  Reviews page (/pages/reviews): every entry in Content > Metaobjects > Google review, shown word for word,
  in "Home page order" first and then the rest. Each review links to the products it mentions.
  The overall rating uses Judge.me's store-review figures when it has them, otherwise the numbers set below.
{%- endcomment -%}
{%- liquid
  assign hero_heading = section.settings.hero_heading | default: page.title
  assign g_total = shop.metafields.judgeme.shop_reviews_count.value | default: shop.metafields.judgeme.shop_reviews_count | plus: 0
  assign g_avg = shop.metafields.judgeme.shop_reviews_rating.value | default: shop.metafields.judgeme.shop_reviews_rating | plus: 0
  if g_total == 0
    assign g_total = section.settings.google_count | plus: 0
    assign g_avg = section.settings.google_rating | plus: 0
  endif
  assign g_avg = g_avg | times: 1.0 | round: 1
  assign g_count = shop.metaobjects.google_review.values.size
-%}
{%- render 'page-hero', style: 'faq', kicker: section.settings.hero_kicker, heading: hero_heading, text: section.settings.hero_text -%}
<section class="rv-shell">
  {%- if g_total > 0 -%}
  <div class="rv-summary">
    {%- assign full = g_avg | round | at_most: 5 -%}{%- assign rest = 5 | minus: full -%}
    <div class="rv-score"><strong>{{ g_avg }}</strong><span class="rv-stars" aria-hidden="true">{% for i in (1..full) %}★{% endfor %}{% if rest > 0 %}<span class="gr-empty">{% for i in (1..rest) %}★{% endfor %}</span>{% endif %}</span></div>
    <p>out of 5 from {{ g_total }} Google review{% if g_total != 1 %}s{% endif %}</p>
    {%- if section.settings.google_link != blank -%}
    <a class="rv-google" href="{{ section.settings.google_link }}" target="_blank" rel="noopener">{{ section.settings.google_label }}&nbsp;&rarr;</a>
    {%- endif -%}
  </div>
  {%- endif -%}
  {%- if g_count > 0 -%}
  <div class="rv-grid">
    {%- for n in (0..60) -%}
      {%- for r in shop.metaobjects.google_review.values -%}
        {%- assign ord = r.home_order.value | default: 61 -%}
        {%- if ord == n -%}{% render 'google-review-card', r: r, featured: false, compact: true, show_products: true %}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- for r in shop.metaobjects.google_review.values -%}
      {%- assign ord = r.home_order.value | default: 61 -%}
      {%- if ord > 60 -%}{% render 'google-review-card', r: r, featured: false, compact: true, show_products: true %}{%- endif -%}
    {%- endfor -%}
  </div>
  <p class="rv-note">{{ section.settings.note }}</p>
  {%- else -%}
  <p class="rv-note">Reviews are on their way.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Reviews page",
  "settings": [
    { "type": "text", "id": "hero_kicker", "label": "Small heading", "default": "Original Skinn" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "default": "Reviews" },
    { "type": "textarea", "id": "hero_text", "label": "Text", "default": "What our customers say about us on Google, shown word for word." },
    { "type": "text", "id": "google_rating", "label": "Google rating (fallback)", "default": "5", "info": "Used only until Judge.me reports the store-review total itself." },
    { "type": "number", "id": "google_count", "label": "Number of Google reviews (fallback)", "default": 20 },
    { "type": "url", "id": "google_link", "label": "Link to the reviews on Google" },
    { "type": "text", "id": "google_label", "label": "Google link label", "default": "See us on Google" },
    { "type": "textarea", "id": "note", "label": "Note under the reviews", "default": "Reviews left on our Google Business Profile, shown word for word.", "info": "Reviews come from Content > Metaobjects > Google review." }
  ]
}
{% endschema %}

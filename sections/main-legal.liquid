{%- comment -%}
  Privacy Policy, Terms & Conditions and Cookie Policy pages — copied from the test site.
  Each numbered part is a "Part" block (numbered automatically). Parts with a "menu label"
  also get a link in the menu on the left.
{%- endcomment -%}
{%- assign st = section.settings.style -%}
{%- assign hero_heading = section.settings.hero_heading | default: page.title -%}
{%- render 'page-hero', style: st, kicker: section.settings.hero_kicker, heading: hero_heading, text: section.settings.hero_text -%}
<section class="{{ st }}-shell">
<div class="{{ st }}-updated">
<span>Last updated</span>
<strong>{{ section.settings.updated }}</strong>
</div>
<div class="{{ st }}-layout">
<nav aria-label="{{ section.settings.nav_label | escape }}" class="{{ st }}-nav">
{%- for block in section.blocks -%}{%- if block.settings.nav_label != blank %}
<a href="#{{ block.settings.anchor | default: block.id | handleize }}">{{ block.settings.nav_label }}</a>
{%- endif -%}{%- endfor %}
</nav>
<article class="{{ st }}-content">
{%- for block in section.blocks %}
<section id="{{ block.settings.anchor | default: block.id | handleize }}" {{ block.shopify_attributes }}>
<span class="{{ st }}-number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
<h2>{{ block.settings.heading }}</h2>
{{ block.settings.body }}
{%- if block.settings.extra_html != blank %}
{{ block.settings.extra_html }}
{%- endif %}
</section>
{%- endfor %}
</article>
</div>
</section>

{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "select", "id": "style", "label": "Page style", "default": "privacy", "options": [
      { "value": "privacy", "label": "Privacy Policy" },
      { "value": "terms", "label": "Terms & Conditions" },
      { "value": "cookie", "label": "Cookie Policy" }
    ] },
    { "type": "text", "id": "hero_kicker", "label": "Small heading", "default": "Original Skinn" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "hero_text", "label": "Text under the heading" },
    { "type": "text", "id": "updated", "label": "Last updated", "default": "21 September 2026" },
    { "type": "text", "id": "nav_label", "label": "Menu name (for screen readers)", "default": "Policy sections" }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Part",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "text", "id": "nav_label", "label": "Menu label", "info": "Leave empty to leave this part out of the menu on the left." },
        { "type": "text", "id": "anchor", "label": "Link name (no spaces)", "info": "e.g. who — the menu link goes to #who." },
        { "type": "richtext", "id": "body", "label": "Text" },
        { "type": "html", "id": "extra_html", "label": "Extra layout (HTML)", "info": "Only needed for special layouts, e.g. the cookie type boxes." }
      ]
    }
  ]
}
{% endschema %}

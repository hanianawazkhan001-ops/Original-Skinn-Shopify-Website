{%- comment -%}
  Home: a small banner that sends people to the skin quiz page.
{%- endcomment -%}
{%- assign q_link = section.settings.link | default: '/pages/skin-quiz' -%}
<section class="quiz-banner"><div class="container">
<a class="qb-box" href="{{ q_link }}">
  <span class="qb-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"/><path d="M9.6 9.3a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.6"/><circle cx="12" cy="16.9" r=".4" fill="currentColor"/></svg></span>
  <span class="qb-text">
    {%- if section.settings.kicker != blank -%}<span class="qb-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
    <strong class="qb-heading">{{ section.settings.heading }}</strong>
    {%- if section.settings.text != blank -%}<span class="qb-sub">{{ section.settings.text }}</span>{%- endif -%}
  </span>
  <span class="qb-btn">{{ section.settings.button }}</span>
</a>
</div></section>

{% schema %}
{
  "name": "Skin quiz banner",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "1-minute skin quiz" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Answer a few quick questions and we’ll suggest a routine from our range." },
    { "type": "text", "id": "button", "label": "Button", "default": "Take the quiz →" },
    { "type": "text", "id": "link", "label": "Link", "default": "/pages/skin-quiz" }
  ],
  "presets": [{ "name": "Skin quiz banner" }]
}
{% endschema %}

{%- comment -%} Home: hero photo and headline band — copied from the test site. {%- endcomment -%}
<section class="hero"><div class="hero-shell"><div class="hero-image">{% render 'os-img', image: section.settings.image, fallback: 'home-hero.jpg', alt: section.settings.image_alt, width: 2400 %}</div></div>
<div class="hero-band"><div class="container hero-band-inner"><h1>{{ section.settings.heading }}</h1><a class="btn primary hero-band-btn" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label }}</a></div></div>
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave empty to use the photo from the test site." },
    { "type": "text", "id": "image_alt", "label": "Photo description (for screen readers)", "default": "Original Skinn plant-led, vegan skincare" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Plant-led, vegan skincare from a small Hampshire brand." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop by ritual →" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#shop", "info": "#shop jumps to the Shop by ritual section." }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}

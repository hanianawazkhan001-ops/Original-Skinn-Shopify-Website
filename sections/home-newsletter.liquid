{%- comment -%}
  Home: newsletter box — copied from the test site.
  Uses Shopify's own sign-up form: emails are saved under Customers with email marketing switched on.
{%- endcomment -%}
<section class="newsletter" id="newsletter"><div class="container"><div class="newsletter-box"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div><div>
{%- form 'customer', class: 'signup', id: 'signup' -%}
<input type="hidden" name="contact[tags]" value="newsletter">
<input aria-label="Email address" autocomplete="email" placeholder="Your email address" required="" type="email" name="contact[email]"/><button type="submit">Join the list</button>
{%- if form.posted_successfully? -%}{%- assign signup_msg = section.settings.success -%}{%- elsif form.errors -%}{%- assign signup_msg = 'Please check your email address and try again.' -%}{%- endif -%}
{%- endform -%}
<div class="signup-msg" id="signupMsg" role="status">{{ signup_msg }}</div><p class="signup-privacy">By joining you agree to our <a href="{{ section.settings.privacy_link }}">Privacy Policy</a>.</p></div></div></div></section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little skincare inspiration in your inbox." },
    { "type": "text", "id": "text", "label": "Text", "default": "New launches, simple skincare tips and the occasional offer. No spam." },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you — you’re on the list." },
    { "type": "text", "id": "privacy_link", "label": "Privacy Policy link", "default": "/policies/privacy-policy" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

{%- comment -%}
  Footer — copied from the test site. Each column can use a Shopify menu chosen in
  the theme editor; until one is chosen, the test site's links are shown.
{%- endcomment -%}
{%- assign brand = settings.brand_name | default: 'Original Skinn' -%}
<footer><div class="container"><div class="footer-grid">
<div class="footer-brand"><img alt="{{ brand | escape }} logo" src="{{ 'logo.png' | asset_url }}" width="165" height="165"/><div><strong>{{ brand }}</strong><p>{{ section.settings.about_text }}</p>{%- if section.settings.contact_email != blank -%}<a class="footer-email" href="mailto:{{ section.settings.contact_email | strip }}"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.8 6.6 8.2 6.4 8.2-6.4"/></svg>{{ section.settings.contact_email | strip }}</a>{%- endif -%}</div></div>
<div class="footer-col"><b>{{ section.settings.col1_title }}</b>
{%- if section.settings.col1_menu != blank -%}
  {%- for link in linklists[section.settings.col1_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
{%- else -%}
<a href="{{ routes.collections_url }}/face">Face</a><a href="{{ routes.collections_url }}/body">Body</a><a href="{{ routes.collections_url }}/hand">Hand</a><a href="{{ routes.collections_url }}/hair">Hair</a><a href="{{ routes.collections_url }}/bath-shower">Bath &amp; Shower</a><a href="{{ routes.collections_url }}/baby">Baby</a><a href="{{ routes.collections_url }}/home-fragrance">Home Fragrance</a><a href="{{ routes.collections_url }}/aromatherapy">Aromatherapy</a><a href="{{ routes.collections_url }}/bundles">Bundles</a>{%- capture qz -%}{% render 'quiz-url' %}{%- endcapture -%}{%- if qz != blank %}<a href="{{ qz }}">Skin quiz</a>{% endif %}
{%- endif -%}
</div>
<div class="footer-col"><b>{{ section.settings.col2_title }}</b>
{%- if section.settings.col2_menu != blank -%}
  {%- for link in linklists[section.settings.col2_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
{%- else -%}
<a href="/pages/about">About Us</a><a href="/pages/ingredients">Ingredients</a>{% if pages.reviews.url != blank and pages.reviews.published_at != blank %}<a href="{{ pages.reviews.url }}">Reviews</a>{% endif %}<a href="/pages/faqs">FAQ</a><a href="/pages/contact">Contact</a>
{%- endif -%}
</div>
<div class="footer-col"><b>{{ section.settings.col3_title }}</b>
{%- if section.settings.col3_menu != blank -%}
  {%- for link in linklists[section.settings.col3_menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
{%- else -%}
<a href="/pages/delivery-returns">Delivery</a><a href="/pages/delivery-returns">Returns</a><a href="/pages/privacy">Privacy</a><a href="/pages/terms">Terms</a><a href="/pages/cookie-policy">Cookie Policy</a>
{%- endif -%}
</div>
</div><div class="footer-bottom"><span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.company_line }}</span></div></div></footer>

{%- style -%}
.footer-email{display:inline-flex;align-items:center;gap:8px;margin-top:14px;color:#edf3ee;font-size:13px;text-decoration:none;overflow-wrap:anywhere;transition:color .22s ease}
.footer-email svg{width:16px;height:16px;flex:none;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linejoin:round;opacity:.85}
.footer-email:hover{color:#d9c3a2}
{%- endstyle -%}

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "about_text", "label": "Short description", "default": "Plant-led, vegan skincare and home fragrance. An independent brand from Hampshire, UK." },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "original@originalskinn.com", "info": "Shown under the description. Leave empty to hide it." },
    { "type": "header", "content": "Column 1" },
    { "type": "text", "id": "col1_title", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "col1_menu", "label": "Menu", "info": "Leave empty to show the standard shop links." },
    { "type": "header", "content": "Column 2" },
    { "type": "text", "id": "col2_title", "label": "Heading", "default": "About" },
    { "type": "link_list", "id": "col2_menu", "label": "Menu", "info": "Leave empty to show About Us, Ingredients, Reviews, FAQ and Contact." },
    { "type": "header", "content": "Column 3" },
    { "type": "text", "id": "col3_title", "label": "Heading", "default": "Help" },
    { "type": "link_list", "id": "col3_menu", "label": "Menu", "info": "Leave empty to show Delivery, Returns, Privacy, Terms and Cookie Policy." },
    { "type": "header", "content": "Company details" },
    { "type": "textarea", "id": "company_line", "label": "Company line", "default": "OriginalSkin Ltd, trading as Original Skinn · Registered in England and Wales, company no. 15919300 · Registered office: Pepys Cottage Bounce, Hook, South Warnborough, Hampshire, RG29 1RX" }
  ]
}
{% endschema %}

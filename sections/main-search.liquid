{%- comment -%}
  Search results (/search?q=...) — uses the shop page design: hero, then product cards.
  Only products are searched.
{%- endcomment -%}
{%- paginate search.results by 50 -%}
{%- liquid
  assign q = search.terms | escape
  assign products_found = search.results | where: 'object_type', 'product'
-%}
<section class="shop-hero">
<div aria-hidden="true" class="shop-leaf shop-leaf-a"></div>
<div aria-hidden="true" class="shop-leaf shop-leaf-b"></div>
<div class="shop-hero-inner">
<span class="shop-kicker">{{ section.settings.kicker }}</span>
<h1>{{ section.settings.heading }}</h1>
<form action="{{ routes.search_url }}" method="get" role="search" class="os-search">
<input type="hidden" name="type" value="product"/>
<input type="hidden" name="options[prefix]" value="last"/>
<input aria-label="Search products" name="q" placeholder="{{ section.settings.placeholder | escape }}" type="search" value="{{ q }}"/>
<button type="submit">Search</button>
</form>
</div>
</section>
<section aria-label="Search results" class="shop-shell">
{%- if search.performed %}
<div class="shop-controls category-controls">
<span id="productCount">{{ products_found.size }} {% if products_found.size == 1 %}result{% else %}results{% endif %} for “{{ q }}”</span>
</div>
{%- if products_found.size > 0 %}
<div class="shop-grid" id="productGrid">
{%- for product in products_found -%}
{%- render 'shop-card', product: product, order: forloop.index0 -%}
{%- endfor -%}
</div>
{%- else %}
<div class="category-intro">
<h2>{{ section.settings.none_heading }}</h2>
<p>{{ section.settings.none_text }}</p>
</div>
{%- endif -%}
{%- endif %}
</section>
{%- endpaginate -%}
{%- style -%}
.os-search{display:flex;gap:8px;max-width:460px;margin:22px auto 0}
.os-search input[type=search]{flex:1;min-width:0;height:48px;border:1px solid #d1d9d1;border-radius:999px;background:#fff;padding:0 18px;color:var(--forest);font:400 13px/1 -apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;outline:none}
.os-search input[type=search]:focus{border-color:var(--forest)}
.os-search button{height:48px;border:0;border-radius:999px;background:var(--forest);color:#fff;padding:0 22px;font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
{%- endstyle -%}

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Original Skinn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Search box hint", "default": "Search our products" },
    { "type": "text", "id": "none_heading", "label": "No results: heading", "default": "Nothing found" },
    { "type": "textarea", "id": "none_text", "label": "No results: text", "default": "Try a different word, or browse the full range on our Shop All page." }
  ]
}
{% endschema %}

{%- comment -%} Top announcement bar — copied from the test site. {%- endcomment -%}
<div class="announcement">
<span aria-hidden="true" class="announcement-icon">
<svg focusable="false" role="img" viewBox="0 0 24 24">
<path d="M1.5 6.5h12v9h-12z"></path>
<path d="M13.5 9.5h4l2.5 3v3h-6.5z"></path>
<circle cx="6" cy="18" r="1.75"></circle>
<circle cx="17.5" cy="18" r="1.75"></circle>
</svg>
</span>
<span class="announcement-text">{{ section.settings.text }}</span>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free Delivery on UK Orders Over £30" }
  ]
}
{% endschema %}

{%- comment -%}
  Product page — copied from the test site (one layout for every product).
  The words come from the product in Shopify. The title is split into the name and the line under
  it ("Rose Whipped Body Butter – Nourishing & Romantic"). The description is split at its
  headings: the text before the first heading is the summary; "What You'll Notice" becomes the
  ticks; "How to Use", "Ingredients", "The Details", "Dispatch" and "FAQ" go into the tabs below.
  The product's own fields (custom.tagline, benefits, how_to_use, ingredients, details,
  ritual_handles, breadcrumb, short_name) are used instead when they are filled in.
{%- endcomment -%}
{% capture nl %}
{% endcapture %}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign mf = product.metafields.custom
  capture p_name
    render 'product-name', product: product, part: 'name'
  endcapture
  capture p_tag
    render 'product-name', product: product, part: 'tagline'
  endcapture

  # split the description at its headings
  assign desc = product.description | default: ''
  assign parts = desc | split: '<h3>'
  assign intro = parts.first | default: ''
  assign p_benefits = ''
  assign p_how = ''
  assign p_ingr = ''
  assign p_details = ''
  assign p_dispatch = ''
  assign p_faq = ''
  assign p_more = ''
  for part in parts offset: 1
    assign hb = part | split: '</h3>'
    assign head_raw = hb.first
    assign head_text = head_raw | strip_html | strip
    assign head = head_text | downcase
    assign body = part | remove_first: head_raw | remove_first: '</h3>' | strip
    if head contains 'notice' or head contains 'love it' or head contains 'benefit'
      assign items = body | split: '</li>'
      for it in items
        assign x = it | strip_html | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | strip
        if x != blank
          assign p_benefits = p_benefits | append: x | append: '|~|'
        endif
      endfor
    elsif head contains 'how to use'
      assign p_how = p_how | append: body
    elsif head contains 'ingredient'
      assign p_ingr = body | replace: '</p>', nl | replace: '<br>', nl | replace: '<br/>', nl | replace: '<br />', nl | strip_html | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | strip
    elsif head contains 'detail'
      assign p_details = body | strip_html | replace: '&amp;', '&' | replace: '&#39;', "'" | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | strip
    elsif head contains 'dispatch' or head contains 'delivery'
      assign p_dispatch = p_dispatch | append: body
    elsif head == 'faq' or head contains 'faqs' or head contains 'question'
      assign p_faq = p_faq | append: body
    elsif head contains 'care' or head contains 'safety' or head contains 'warning'
      assign p_how = p_how | append: '<p><strong>' | append: head_text | append: '</strong></p>' | append: body
    elsif head contains 'includ'
      assign inc_p = '<p>' | append: head_text | append: ': '
      assign body2 = body | replace_first: '<p>', inc_p
      assign p_more = p_more | append: body2
    else
      assign p_more = p_more | append: body
    endif
  endfor

  assign benefit_list = mf.benefits.value
  if benefit_list == blank
    assign benefit_list = p_benefits | split: '|~|'
  endif
  assign detail_list = mf.details.value
  if detail_list == blank
    assign detail_list = ''
    assign dbits = p_details | split: ' · '
    for d in dbits
      assign x = d | strip
      assign last = x | slice: -1
      if last == '.'
        assign len = x.size | minus: 1
        assign x = x | slice: 0, len
      endif
      if x != blank
        assign detail_list = detail_list | append: x | append: '|~|'
      endif
    endfor
    assign detail_list = detail_list | split: '|~|'
  endif
  assign ingr_text = mf.ingredients.value | default: p_ingr
  assign ingr_text = ingr_text | replace: '.*', '.__NL__*' | replace: '__NL__', nl

  # size next to the price, for products that come in one size ("100 ml · ...")
  assign one_size = ''
  if product.variants.size == 1 and detail_list.size > 0
    assign d0 = detail_list.first | strip
    assign c0 = d0 | slice: 0
    if '0123456789' contains c0
      if d0 contains 'ml' or d0 contains ' g' or d0 contains 'g '
        assign one_size = d0
      endif
    endif
  endif

  assign crumb = mf.breadcrumb.value
  if crumb == blank
    capture crumb
      render 'product-cats', product: product, mode: 'label'
    endcapture
  endif
  capture cat_label
    render 'product-cats', product: product, mode: 'label'
  endcapture
  capture crumb_handle
    render 'product-cats', product: product, mode: 'first-handle'
  endcapture
  if crumb_handle == blank
    assign crumb_url = routes.all_products_collection_url
  else
    assign crumb_url = routes.collections_url | append: '/' | append: crumb_handle
  endif
  assign main_alt = product.featured_image.alt | default: p_name

  # Photos for one option: end the photo's alt text with the option in square brackets,
  # e.g. "Original Skinn AM Face Ritual set [AM only]". Those photos show only when that option is
  # picked; the photos without brackets show for every option that has no photos of its own.
  assign sel_opt = v.title
  assign photo_groups = '|'
  for img in product.images
    assign a = img.alt | default: ''
    assign lc = a | slice: -1
    if lc == ']' and a contains ' ['
      assign g = a | split: ' [' | last | remove: ']'
      assign photo_groups = photo_groups | append: g | append: '|'
    endif
  endfor
  assign sel_key = '|' | append: sel_opt | append: '|'
  assign sel_has_photos = false
  if photo_groups contains sel_key
    assign sel_has_photos = true
  endif
  assign main_img = product.featured_image
  for img in product.images
    assign a = img.alt | default: ''
    assign g = ''
    assign lc = a | slice: -1
    if lc == ']' and a contains ' ['
      assign g = a | split: ' [' | last | remove: ']'
    endif
    if g == sel_opt or g == blank and sel_has_photos == false
      assign main_img = img
      if g != blank
        assign tag = ' [' | append: g | append: ']'
        assign main_alt = a | remove: tag
      else
        assign main_alt = a | default: p_name
      endif
      break
    endif
  endfor

  # optional extra (e.g. the Hand Cream on the Day & Night Face Ritual), set in the theme editor
  assign addon = nil
  assign addon_for = section.settings.addon_for
  if addon_for != blank and addon_for.id == product.id and section.settings.addon_product != blank
    assign addon = section.settings.addon_product
    unless addon.available
      assign addon = nil
    endunless
  endif
-%}
<nav aria-label="Breadcrumb" class="product-breadcrumbs">
<a href="{{ routes.root_url }}">Home</a>
<span>›</span>
<a href="{{ crumb_url }}" id="pdCrumbCat">{{ crumb }}</a>
<span>›</span>
<span id="pdCrumbName">{{ p_name }}</span>
</nav>
<section class="product-top">
<div class="product-gallery">
<div class="product-main-image" id="mainProductImageWrap">
<span class="product-badge" id="pdBadge"{% unless product.tags contains 'best-seller' %} hidden{% endunless %}>Best Seller</span>
{%- if main_img != blank -%}<img alt="{{ main_alt | escape }}" id="mainProductImage" src="{{ main_img | image_url: width: 1400 }}"/>{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'os-placeholder' }}{%- endif -%}
</div>
<div aria-label="Product images" class="product-thumbs" id="pdThumbs">
{%- for img in product.images -%}
{%- liquid
  assign a = img.alt | default: ''
  assign g = ''
  assign lc = a | slice: -1
  if lc == ']' and a contains ' ['
    assign g = a | split: ' [' | last | remove: ']'
    assign tag = ' [' | append: g | append: ']'
    assign a = a | remove: tag
  endif
  assign show = true
  if g != blank and g != sel_opt
    assign show = false
  elsif g == blank and sel_has_photos
    assign show = false
  endif
-%}
<button aria-label="View image {{ forloop.index }}" class="product-thumb{% if img.id == main_img.id %} active{% endif %}" data-src="{{ img | image_url: width: 1400 }}" data-alt="{{ a | default: p_name | escape }}"{% if g != blank %} data-group="{{ g | escape }}"{% endif %}{% unless show %} hidden{% endunless %} type="button"><img alt="" loading="lazy" src="{{ img | image_url: width: 300 }}"/></button>
{%- endfor -%}
</div>
</div>
<div class="product-info-panel">
<span class="product-kicker" id="pdKicker">{{ cat_label }}</span>
<h1 id="pdName">{{ p_name }}</h1>
{%- if section.settings.judgeme %}
{% render 'reviews-style' %}
<div class="jdgm-widget jdgm-preview-badge os-rating" data-id="{{ product.id }}">{{ product.metafields.judgeme.badge }}</div>
{%- endif %}
<p class="product-subtitle" id="pdTag">{{ p_tag }}</p>
<div class="product-price-row">
<strong id="pdPrice">{{ v.price | money }}</strong>
<span class="product-size" id="pdSize">{% if v.title == 'Default Title' %}{{ one_size }}{% else %}{{ v.title }}{% endif %}</span>
</div>
<div class="product-summary">
{%- assign summary = intro | append: p_more | remove: '<strong>' | remove: '</strong>' | strip -%}
{%- if summary contains '<p' -%}{{ summary | replace_first: '<p>', '<p id="pdDesc">' }}{%- else -%}<p id="pdDesc">{{ summary }}</p>{%- endif -%}
</div>
<div class="product-benefits" id="pdBenefits">{% for b in benefit_list %}{% if b != blank %}<div><span>✓</span> {{ b | escape }}</div>{% endif %}{% endfor %}</div>
{% render 'bundle-choices', product: product, mode: 'picker' %}
<div class="pd-sizes" id="pdSizes" role="group" aria-label="{{ product.options.first | default: 'Size' | escape }}"{% if product.variants.size < 2 %} hidden{% endif %}>
{%- if product.variants.size > 1 -%}{%- for vv in product.variants -%}<button type="button" class="pd-size{% if vv.id == v.id %} active{% endif %}" data-variant="{{ vv.id }}" data-price="{{ vv.price | money }}" data-cents="{{ vv.price }}" data-size="{{ vv.title | escape }}"{% if vv.featured_image %} data-img="{{ vv.featured_image | image_url: width: 1400 }}"{% endif %}{% unless vv.available %} disabled{% endunless %}>{{ vv.title }}</button>{%- endfor -%}{%- endif -%}
</div>
{%- if addon != blank -%}
{%- capture addon_name -%}{% render 'product-name', product: addon, part: 'name' %}{%- endcapture -%}
{%- assign addon_name = addon_name | strip -%}
{%- assign av = addon.selected_or_first_available_variant -%}
<label class="pd-addon">
<input type="checkbox" id="pdAddon" data-variant="{{ av.id }}" data-cents="{{ av.price }}" data-name="{{ addon_name | escape }}">
{%- if addon.featured_image != blank %}<img alt="" loading="lazy" src="{{ addon.featured_image | image_url: width: 120 }}"/>{% endif %}
<span class="pd-addon-text"><strong>{{ section.settings.addon_label | replace: '[name]', addon_name }}</strong>{% if section.settings.addon_note != blank %}<small>{{ section.settings.addon_note }}</small>{% endif %}</span>
<span class="pd-addon-price">+{{ av.price | money_without_trailing_zeros }}</span>
</label>
{%- endif -%}
<div class="product-purchase">
<div aria-label="Quantity" class="qty-control">
<button aria-label="Decrease quantity" id="qtyMinus" type="button">−</button>
<input aria-label="Quantity" id="qtyInput" inputmode="numeric" value="1"/>
<button aria-label="Increase quantity" id="qtyPlus" type="button">+</button>
</div>
<button class="add-to-cart" id="pdAdd" type="button" data-variant="{{ v.id }}" data-cents="{{ v.price }}" data-product="{{ p_name | escape }}"{% unless product.available %} disabled{% endunless %}>{% if product.available %}Add to bag · {{ v.price | money }}{% else %}Sold out{% endif %}</button>
</div>
<div class="delivery-note">
<span aria-hidden="true" class="delivery-note-icon">
<svg viewBox="0 0 24 24"><path d="M1.5 6.5h12v9h-12z"></path><path d="M13.5 9.5h4l2.5 3v3h-6.5z"></path><circle cx="6" cy="18" r="1.75"></circle><circle cx="17.5" cy="18" r="1.75"></circle></svg>
</span>
<span>{{ section.settings.delivery_note }}</span>
</div>
{%- liquid
  assign partners = ''
  assign total = 0
  assign names = ''
  assign ids = ''
  assign count = 0
  for h in mf.ritual_handles.value
    assign q = all_products[h]
    if q != blank and q.id != product.id
      assign count = count | plus: 1
      assign total = total | plus: q.price
    endif
  endfor
-%}
{%- if count > 0 %}
<section class="complete-ritual" aria-label="Complete your ritual" id="pdRitual">
<span class="cr-kicker">Complete your ritual</span>
<div class="cr-tiles" id="pdRitualTiles"{% if count == 1 %} style="grid-template-columns: 1fr;"{% endif %}>
{%- for h in mf.ritual_handles.value -%}
{%- assign q = all_products[h] -%}
{%- if q != blank and q.id != product.id -%}
{%- liquid
  capture qname
    render 'product-name', product: q, part: 'short'
  endcapture
  if names != blank
    assign names = names | append: ' + '
  endif
  assign names = names | append: qname
  assign ids = ids | append: q.selected_or_first_available_variant.id | append: ','
  case q.type
    when 'Face Wash'
      assign step = 'Step 1 · Cleanse'
    when 'Toner'
      assign step = 'Step 2 · Refresh'
    when 'Facial Serum'
      assign step = 'Step 3 · Serum'
    when 'Facial Moisturiser'
      assign step = 'Step 4 · Moisturise'
    when 'Salt Scrub'
      assign step = 'Scrub'
    when 'Bath Soak'
      assign step = 'Soak'
    when 'Body Butter'
      assign step = 'Butter'
    when 'Shower Gel', 'Baby Wash'
      assign step = 'Wash'
    when 'Baby Moisturiser'
      assign step = 'Moisturise'
    when 'Candles'
      assign step = 'Candle'
    when 'Aromatherapy Car Blend'
      assign step = 'On the go'
    else
      capture step
        render 'product-cats', product: q, mode: 'label'
      endcapture
  endcase
-%}
<div class="cr-tile"><a class="cr-img" href="{{ q.url }}" tabindex="-1" aria-hidden="true"><img alt="" loading="lazy" src="{{ q.featured_image | image_url: width: 300 }}"/></a><div><span class="cr-step">{{ step }}</span><a class="cr-name card-title-link" href="{{ q.url }}">{{ qname }}</a><span class="cr-price">{{ q.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span></div></div>
{%- endif -%}
{%- endfor %}
</div>
<button class="cr-add" data-product="{{ names | escape }}" data-variants="{{ ids }}" id="pdRitualAdd" type="button">{% if count > 2 %}Add all {{ count }} — {% elsif count > 1 %}Add both — {% else %}Add — {% endif %}{{ total | money_without_trailing_zeros }}</button>
{%- liquid
  assign thr = section.settings.free_threshold | times: 100
  assign in_bag_now = cart.items_subtotal_price
  # the product on this page plus the ritual partners
  assign after = in_bag_now | plus: v.price | plus: total
  assign cr_note = ''
  if in_bag_now < thr
    if after >= thr
      assign cr_note = section.settings.ritual_note_unlock
    else
      assign left = thr | minus: after | money
      assign cr_note = section.settings.ritual_note_away | replace: '[amount]', left
    endif
  endif
-%}
{%- if cr_note != blank %}<p class="cr-note">{{ cr_note }}</p>{% endif %}
</section>
{%- endif %}
{%- capture qz -%}{% render 'quiz-url' %}{%- endcapture -%}{%- if qz != blank %}<p class="quiz-nudge quiz-nudge--small quiz-nudge--product"><a href="{{ qz }}">Want a routine built for you? Take the 1-minute skin quiz →</a></p>{% endif %}
<div class="product-accordions">
<details open="">
<summary>How to use <span>+</span></summary>
<div class="accordion-copy" id="pdHow">{% if mf.how_to_use.value != blank %}{% for h in mf.how_to_use.value %}<p>{{ h | escape }}</p>{% endfor %}{% else %}{{ p_how }}{% endif %}</div>
</details>
<details>
<summary>Ingredients <span>+</span></summary>
<div class="accordion-copy" id="pdIngr">{% render 'product-ingredients', text: ingr_text, note: section.settings.ingredients_note %}</div>
</details>
<details>
<summary>Details <span>+</span></summary>
<div class="accordion-copy" id="pdDetails"><ul class="detail-list">{% for d in detail_list %}{% if d != blank %}<li>{{ d | escape }}</li>{% endif %}{% endfor %}</ul></div>
</details>
<details>
<summary>Delivery &amp; returns <span>+</span></summary>
<div class="accordion-copy">
{%- if section.settings.dispatch_text != blank %}<p>{{ section.settings.dispatch_text }}</p>{% else %}{{ p_dispatch }}{% endif %}
<p>{{ section.settings.delivery_text }} See our <a href="{{ section.settings.delivery_link }}">Delivery &amp; Returns page</a> for dispatch times and how to return an item.</p>
</div>
</details>
{%- if p_faq != blank %}
<details>
<summary>FAQs <span>+</span></summary>
<div class="accordion-copy">{{ p_faq }}</div>
</details>
{%- endif %}
</div>
</div>
</section>
{%- style -%}
.os-placeholder{display:block;width:100%;height:100%;background:#f1efe8;fill:#c9cfc6}
.product-summary p+p{margin-top:10px}
.accordion-copy ul{margin:0;padding-left:16px;color:#68746e;font-size:11px;line-height:1.7}
.product-thumb[hidden]{display:none}
.pd-addon{display:flex;align-items:center;gap:10px;margin:0 0 14px;padding:10px 12px;border:1px dashed #9bb0a1;border-radius:12px;background:#fbfaf6;cursor:pointer}
.pd-addon input{width:18px;height:18px;margin:0;flex:none;accent-color:#2f4b3a}
.pd-addon img{width:40px;height:40px;object-fit:cover;border-radius:8px;flex:none}
.pd-addon-text{flex:1;min-width:0;font-size:12px;line-height:1.4;color:#24352b}
.pd-addon-text strong{display:block;font-weight:600}
.pd-addon-text small{display:block;color:#68746e;font-size:11px}
.pd-addon-price{flex:none;font-weight:600;font-size:13px;color:#24352b}
.pd-addon:has(input:checked){border-style:solid;border-color:#2f4b3a;background:#f1f4ee}
{%- endstyle -%}
{%- liquid
  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor
  assign legacy_widget = product.metafields.judgeme.widget
  assign show_reviews = false
  if app_blocks > 0
    assign show_reviews = true
  elsif section.settings.judgeme and legacy_widget != blank
    assign show_reviews = true
  endif
-%}
{%- comment -%} Google reviews that name this product (Content > Metaobjects > Google review > "Products it mentions") {%- endcomment -%}
{%- capture g_cards -%}
{%- if section.settings.google_reviews -%}
{%- for g_rev in shop.metaobjects.google_review.values -%}
  {%- assign hit = false -%}
  {%- for g_prod in g_rev.products.value -%}{%- if g_prod.id == product.id -%}{%- assign hit = true -%}{%- endif -%}{%- endfor -%}
  {%- if hit -%}{% render 'google-review-card', r: g_rev, featured: false, compact: true %}{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endcapture -%}
{%- assign g_cards = g_cards | strip -%}
{%- if g_cards != blank -%}{%- assign show_reviews = true -%}{%- endif -%}
{%- if show_reviews %}
{% render 'reviews-style' %}
<section class="also-like os-reviews" id="reviews">
<h2>{{ section.settings.reviews_heading }}</h2>
{%- if g_cards != blank -%}
<div class="gr-product">
  <p class="gr-product-label">From our Google reviews{% if pages.reviews.url != blank and pages.reviews.published_at != blank %} <a href="{{ pages.reviews.url }}">See all reviews&nbsp;&rarr;</a>{% endif %}</p>
  <div class="gr-list">{{ g_cards }}</div>
</div>
{%- endif -%}
{%- if app_blocks > 0 -%}
{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}
{%- else %}
<div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-id="{{ product.id }}">{{ legacy_widget }}</div>
{%- endif %}
</section>
{%- endif %}
<section class="also-like">
<h2>{{ section.settings.also_heading }}</h2>
<div class="also-grid" id="pdAlso">
{%- liquid
  assign pool = collections.all.products | sort: 'id'
  # hand, hair and baby care sit with body care, so their last suggestions come from Body
  assign also_handle = crumb_handle
  if crumb_handle == 'hand' or crumb_handle == 'hair' or crumb_handle == 'baby'
    assign also_handle = 'body'
  endif
  assign shown = 0
  assign used = ' ' | append: product.handle | append: ' '
-%}
{%- for q in pool -%}{%- if shown < 4 -%}
{%- capture qlabel -%}{% render 'product-cats', product: q, mode: 'label' %}{%- endcapture -%}
{%- assign key = ' ' | append: q.handle | append: ' ' -%}
{%- unless used contains key -%}{%- if qlabel == cat_label -%}
{%- render 'shop-card', product: q, plain: true -%}{%- assign shown = shown | plus: 1 -%}{%- assign used = used | append: q.handle | append: ' ' -%}
{%- endif -%}{%- endunless -%}
{%- endif -%}{%- endfor -%}
{%- for q in pool -%}{%- if shown < 4 -%}
{%- assign key = ' ' | append: q.handle | append: ' ' -%}
{%- unless used contains key -%}{%- if mf.ritual_handles.value contains q.handle -%}
{%- render 'shop-card', product: q, plain: true -%}{%- assign shown = shown | plus: 1 -%}{%- assign used = used | append: q.handle | append: ' ' -%}
{%- endif -%}{%- endunless -%}
{%- endif -%}{%- endfor -%}
{%- for q in pool -%}{%- if shown < 4 -%}
{%- assign key = ' ' | append: q.handle | append: ' ' -%}
{%- unless used contains key -%}{%- if q.tags contains 'best-seller' -%}
{%- render 'shop-card', product: q, plain: true -%}{%- assign shown = shown | plus: 1 -%}{%- assign used = used | append: q.handle | append: ' ' -%}
{%- endif -%}{%- endunless -%}
{%- endif -%}{%- endfor -%}
{%- for q in pool -%}{%- if shown < 4 -%}
{%- assign key = ' ' | append: q.handle | append: ' ' -%}
{%- unless used contains key -%}
{%- capture qkeys -%}{% render 'product-cats', product: q, mode: 'first-handle' %}{%- endcapture -%}
{%- if qkeys == also_handle -%}
{%- render 'shop-card', product: q, plain: true -%}{%- assign shown = shown | plus: 1 -%}{%- assign used = used | append: q.handle | append: ' ' -%}
{%- endif -%}{%- endunless -%}
{%- endif -%}{%- endfor -%}
</div>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "text", "id": "delivery_note", "label": "Delivery line under the button", "default": "<strong>Free UK delivery</strong> on every order." },
    { "type": "number", "id": "free_threshold", "label": "Free UK delivery from (£)", "default": 0, "info": "0 = free delivery on every order (the free-delivery notes are then hidden). Keep this the same as the bag page and your shipping rates." },
    { "type": "text", "id": "ritual_note_unlock", "label": "Note when 'Complete your ritual' reaches free delivery", "default": "The full ritual unlocks free UK delivery." },
    { "type": "text", "id": "ritual_note_away", "label": "Note when it doesn't yet", "default": "With the full ritual, you’re [amount] away from free UK delivery.", "info": "[amount] is replaced with what's left to spend." },

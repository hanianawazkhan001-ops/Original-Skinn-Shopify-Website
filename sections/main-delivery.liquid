{%- comment -%}
  Delivery & Returns page — copied from the test site. Add a "Column" block to start a column
  (e.g. Delivery, Returns), then "Point" blocks under it.
{%- endcomment -%}
{%- assign hero_heading = section.settings.hero_heading | default: page.title -%}
{%- render 'page-hero', style: 'delivery', kicker: section.settings.hero_kicker, heading: hero_heading, text: section.settings.hero_text -%}
<section class="delivery-shell">
<div class="delivery-highlight">
<div aria-hidden="true" class="highlight-icon">
<svg viewBox="0 0 24 24">
<path d="M1.5 6.5h12v9h-12z"></path>
<path d="M13.5 9.5h4l2.5 3v3h-6.5z"></path>
<circle cx="6" cy="18" r="1.75"></circle>
<circle cx="17.5" cy="18" r="1.75"></circle>
</svg>
</div>
<div>
<span>{{ section.settings.hl_kicker }}</span>
<h2>{{ section.settings.hl_heading }}</h2>
<p>{{ section.settings.hl_text }}</p>
</div>
</div>
<div class="policy-grid">
{%- assign c = 0 -%}
{%- for block in section.blocks -%}
{%- if block.type == 'column' -%}
{%- if c > 0 %}
</div>
</div>
</section>
{%- endif -%}
{%- assign c = c | plus: 1 %}
<section class="policy-block" {{ block.shopify_attributes }}>
<div class="policy-copy">
<span class="policy-kicker">{{ block.settings.kicker }}</span>
<h2>{{ block.settings.heading }}</h2>
<div class="policy-list">
{%- elsif block.type == 'point' %}
<div {{ block.shopify_attributes }}>
<h3>{{ block.settings.heading }}</h3>
<p>{{ block.settings.text }}</p>
</div>
{%- endif -%}
{%- endfor -%}
{%- if c > 0 %}
</div>
</div>
</section>
{%- endif %}
</div>
{%- render 'help-box', style: 'delivery-help', kicker: section.settings.help_kicker, heading: section.settings.help_heading, text: section.settings.help_text, link_label: section.settings.help_link_label, link: section.settings.help_link %}
</section>

{% schema %}
{
  "name": "Delivery & Returns page",
  "settings": [
    { "type": "text", "id": "hero_kicker", "label": "Small heading", "default": "Original Skinn" },
    { "type": "text", "id": "hero_heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "hero_text", "label": "Text under the heading", "default": "Simple information about receiving your order and what to do if something isn’t quite right." },
    { "type": "header", "content": "Highlight box" },
    { "type": "text", "id": "hl_kicker", "label": "Small heading", "default": "UK DELIVERY" },
    { "type": "text", "id": "hl_heading", "label": "Heading", "default": "Free delivery on UK orders over £30." },
    { "type": "textarea", "id": "hl_text", "label": "Text", "default": "Any delivery charge for smaller orders will be shown clearly before checkout." },
    { "type": "header", "content": "Help box at the bottom" },
    { "type": "text", "id": "help_kicker", "label": "Small heading", "default": "Need help with an order?" },
    { "type": "text", "id": "help_heading", "label": "Heading", "default": "We’re here to help." },
    { "type": "textarea", "id": "help_text", "label": "Text", "default": "If you have a delivery or returns question, send us your order number and a short description of the issue." },
    { "type": "text", "id": "help_link_label", "label": "Link label", "default": "Contact us →" },
    { "type": "text", "id": "help_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small heading", "default": "Delivery" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Receiving your order" }
      ]
    },
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "UK delivery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We deliver across the UK." }
      ]
    }
  ]
}
{% endschema %}

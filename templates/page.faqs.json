        "q_6": {
          "type": "question",
          "settings": {
            "question": "Are your products suitable for sensitive skin?",
            "answer": "<p>Everyone’s skin is different. Check the ingredient list before use and consider patch testing a small area first. Stop using a product if irritation occurs.</p>"
          }
        },
        "q_7": {
          "type": "question",
          "settings": {
            "question": "How do I know which face product to choose?",
            "answer": "<p>Our Day Facial Moisturiser &amp; Serum is designed for the morning, while the Night Facial Moisturiser &amp; Serum is for your evening routine. The Face Moisturiser Duo pairs both together.</p>"
          }
        },
        "q_8": {
          "type": "question",
          "settings": {
            "question": "How often should I use a salt scrub?",
            "answer": "<p>Follow the directions on the individual product page and packaging. Avoid using a scrub on broken, irritated or freshly shaved skin.</p>"
          }
        },
        "q_9": {
          "type": "question",
          "settings": {
            "question": "Can I use your products during pregnancy?",
            "answer": "<p>If you are pregnant, breastfeeding or have a particular health concern, check the ingredient list and ask a qualified healthcare professional if you are unsure whether a product is suitable for you.</p>"
          }
        },

        "q_1": {
          "type": "question",
          "settings": {
            "question": "What makes Original Skinn products different?",
            "answer": "<p>Original Skinn is an independent skincare brand with a plant-led approach. Our range is designed around simple everyday rituals for face, body, hands, hair, bath, baby and home.</p>"
          }
        },
        "q_2": {
          "type": "question",
          "settings": {
            "question": "Are your products natural and vegan?",
            "answer": "<p>All our products are vegan. Our skincare range is plant-led, built around plant oils and butters with essential oils for scent. Our Black Cherry Body Butter and some of our home fragrance use fragrance oils. The full ingredient list is on every product page and on the packaging.</p>"
          }
        },
        "q_3": {
          "type": "question",
          "settings": {
            "question": "Where can I find the full ingredient list?",
            "answer": "<p>Each product page includes an Ingredients section. The ingredient list on the product packaging should always be treated as the final reference.</p>"
          }
        },
        "q_4": {
          "type": "question",
          "settings": {
            "question": "How should I store my products?",
            "answer": "<p>Keep products closed when not in use and store them away from excessive heat, direct sunlight and moisture unless the packaging says otherwise.</p>"
          }
        },
        "q_5": {
          "type": "question",
          "settings": {
            "question": "How long will a product last once opened?",
            "answer": "<p>Please follow the period-after-opening or expiry information shown on the product packaging, as this can vary between products.</p>"
          }
